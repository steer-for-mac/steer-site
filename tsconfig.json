{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // off for now: 296 errors on, 119 off, and the 119 are all about null
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    // "bun" for scripts/serve.js. Project-wide: `types` cannot be scoped per
    // file. eslint.config.js fences the `Bun` GLOBAL out of the Node gates, but
    // not `import ... from "bun"`, which passes both gates and dies at runtime.
    "types": ["node", "bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/theme.ts", "scripts/**/*.js", "tests/**/*.js", "tools/**/*.js", "*.config.js"],
  // home.js excluded until task #2 finishes rewriting it (72 errors, all null)
  "exclude": ["node_modules", "dist", "scratch", "test-results", "src/home.entry.js"]
}
