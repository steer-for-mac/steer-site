{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // off for now: 296 errors on, 119 off, and the 119 are all about null
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/theme.ts", "scripts/**/*.js", "tests/**/*.js", "tools/**/*.js", "*.config.js"],
  // home.js excluded until task #2 finishes rewriting it (72 errors, all null)
  "exclude": ["node_modules", "dist", "scratch", "test-results", "src/home.js"]
}
