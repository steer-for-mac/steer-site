#!/usr/bin/env python3
"""Assemble index.html from parts/.

One 92KB file meant every edit was surgery on a shared blob and two agents could
not touch different bands at once. Each band is its own file now; this stitches
them back together.

    bin/build           write index.html from parts/
    bin/build --check   exit 1 if index.html is stale (for the commit gate)

Includes only, no template language: the repo's tooling is deliberately
dependency-free (curb-check.mjs, shots.mjs, bin/ci all run on what ships with
the machine), and a pip install to concatenate files would not earn itself.

Syntax, on its own line:

    <!-- include: parts/uses.html -->

Nested includes work. The indentation of the include line is applied to every
line of the included file, so the output stays readable.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "index.src.html"
OUT = ROOT / "index.html"
INCLUDE = re.compile(r"^([ \t]*)<!--\s*include:\s*(\S+?)\s*-->[ \t]*$")

BANNER = (
    "<!-- GENERATED by bin/build from index.src.html and parts/. Do not edit this\n"
    "     file: run bin/build after editing a part, or your change is one build\n"
    "     away from being overwritten. bin/build --check fails on a stale copy. -->\n"
)


def render(path: Path, seen: tuple = ()) -> str:
    if path in seen:
        sys.exit(f"circular include: {' -> '.join(str(p) for p in seen + (path,))}")
    if not path.exists():
        sys.exit(f"missing include: {path.relative_to(ROOT)}")
    out = []
    for line in path.read_text(encoding="utf-8").splitlines(keepends=True):
        m = INCLUDE.match(line.rstrip("\n"))
        if not m:
            out.append(line)
            continue
        indent, target = m.groups()
        body = render(ROOT / target, seen + (path,))
        out.extend(indent + l if l.strip() else l for l in body.splitlines(keepends=True))
    return "".join(out)


def write_home_entry() -> None:
    """home.entry.css lists the band sheets, because @import takes no glob.

    Generated, so adding parts/<band>.css is the only step. Nobody has to
    remember to register it, which is the kind of bookkeeping that rots.
    """
    bands = sorted(p.stem for p in (ROOT / "parts").glob("*.css"))
    (ROOT / "styles" / "home.entry.css").write_text(
        "/* Entry for home.css. GENERATED by bin/build: the band list comes from\n"
        "   parts/*.css, because @import takes no glob. Edit a band's own sheet,\n"
        "   or add a new parts/<band>.css and rebuild. */\n\n"
        "@layer tokens, base, components, bands;\n\n"
        '@import "base.css" layer(components);\n'
        + "".join(f'@import "../parts/{b}.css" layer(bands);\n' for b in bands),
        encoding="utf-8")


def bundle(entry: str, out: str) -> str:
    """Flatten an entry's @imports into one file with Lightning CSS.

    A real bundler rather than string concatenation. It parses, so it cannot cut
    a multi-line selector list in half the way a line filter can, and it
    understands @layer, so the cascade is declared in the entry files instead of
    being implied by the order a script pasted things together in.
    """
    proc = subprocess.run(
        ["npx", "--yes", "lightningcss-cli@1", "--bundle", f"styles/{entry}", "-o", out],
        cwd=ROOT, capture_output=True, text=True)
    if proc.returncode:
        sys.exit(f"lightningcss failed on styles/{entry}:\n{proc.stderr.strip()}")
    return (ROOT / out).read_text(encoding="utf-8")


def main() -> int:
    built = BANNER + render(SRC)
    write_home_entry()

    if "--check" in sys.argv:
        before = {p: (ROOT / p).read_text(encoding="utf-8") for p in ("styles.css", "home.css")
                  if (ROOT / p).exists()}
        bundle("site.entry.css", "styles.css")
        bundle("home.entry.css", "home.css")
        stale = [p for p, was in before.items() if was != (ROOT / p).read_text(encoding="utf-8")]
        for p, was in before.items():
            (ROOT / p).write_text(was, encoding="utf-8")  # --check never mutates
        if (OUT.read_text(encoding="utf-8") if OUT.exists() else "") != built:
            stale.append("index.html")
        if stale:
            print(f"stale, run bin/build: {', '.join(sorted(stale))}", file=sys.stderr)
            return 1
        print("index.html, styles.css and home.css are up to date")
        return 0

    OUT.write_text(built, encoding="utf-8")
    shared = bundle("site.entry.css", "styles.css")
    home = bundle("home.entry.css", "home.css")
    parts = len(re.findall(r"<!--\s*include:", SRC.read_text(encoding="utf-8")))
    bands = len(list((ROOT / "parts").glob("*.css")))
    print(f"index.html <- index.src.html + {parts} parts ({len(built)//1024} KB)")
    print(f"styles.css <- tokens + shared ({len(shared)//1024} KB)")
    print(f"home.css   <- base + {bands} band sheets ({len(home)//1024} KB)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
