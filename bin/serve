#!/bin/sh
# Serve the site. Needed because external <use href="file.svg#id"> is blocked
# over file://, and that was the only reason the SVG symbols were living inline
# in index.html. Python ships with macOS, so this stays dependency-free like
# curb-check.mjs and shots.mjs.
#
#   bin/serve          -> http://localhost:8080
#   bin/serve 4000     -> http://localhost:4000
exec python3 -m http.server "${1:-8080}" --bind 127.0.0.1 --directory "$(dirname "$0")/.."
