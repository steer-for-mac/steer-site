# Build output. Eleventy writes dist/, Lightning CSS writes the two sheets
# inside it. index.html, site.css and home.css are listed because bin/build used
# to write them into the repo root and commit them; nothing generates them there
# any more, and a stray copy would shadow the real page in Eleventy's input
# directory. styles.css is the pre-rename name of site.css, kept so an old
# working copy's leftover cannot be committed back in.
dist/
/index.html
/site.css
/styles.css
/home.css

# Throwaway QA artifacts (screenshots, PoC output)
scratch/
# Anchored. Unanchored, this matched _includes/art/hero-*.svg and silently
# excluded nine required build inputs: a clean checkout of HEAD could not
# build at all (nunjucks: template not found: art/hero-defs.svg). It is meant
# for throwaway hero-*.png renders at the repo root, which now go to scratch/.
/hero-*
node_modules/
# Playwright output. test-results/ holds traces and error context from failed
# runs; playwright-report/ is the HTML reporter's build.
test-results/
playwright-report/

# Working notes that are not published. Kept beside the docs they relate to;
# outside src/, so Eleventy cannot render them either.
docs/private/
