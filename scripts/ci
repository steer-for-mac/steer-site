#!/usr/bin/env python3
"""Run every check, in parallel, and fail loudly.

    make ci           all checks (the documented entry point)
    scripts/ci        the same, without the container `make ci` brings up
    scripts/ci --quick    skip the slow rendering checks

Same shape as ../seanfloyd.dev/bin/ci and ../news-digest: steps run
concurrently, output is printed per step in a stable order, exit is non-zero if
any step fails. Nothing here needs installing; it is all stdlib plus the repo's
own dependency-free scripts.

The rendering checks are the ones that actually catch things. curb-check reads
the source, but the shots gate is what notices a band overflowing at 375, and
dead-css is what noticed the FAQ moving to a page that never loaded its
stylesheet. A check that only reads source would have passed both.
"""
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BOLD, PURPLE, GREEN, RED, DIM, RESET = "\033[1m", "\033[35m", "\033[32m", "\033[31m", "\033[2m", "\033[0m"

QUICK = "--quick" in sys.argv

# Serial, before the parallel block: every step below reads _site/, and Eleventy
# has to have written it. It also replaces the old `bin/build --check` gate --
# there is nothing generated left in the working tree to be stale.
BUILD = ["npx", "eleventy"]

STEPS = [
    ("A11y: structural invariants", ["scripts/a11y-check"], False),
    # `make a11y`, not the node command, for the same reason as the two below:
    # the Makefile is where a task is defined. This is the gate that reads the
    # rendered page -- scripts/a11y-check above is a static parse and cannot see
    # a heading that skips a level relative to the footer, or a link told apart
    # from its paragraph by colour alone. Both of those were live on the shipped
    # site while every check here passed.
    ("A11y: axe-core, WCAG 2 A/AA, every page", ["make", "a11y"], False),
    # `make lint-html`, not the html-validate command, for the reason below.
    # It grades the BUILT pages, which is why the eight rules the old
    # fragment config had to switch off are on again.
    ("Markup: every page in _site/ is a valid document",
     ["make", "lint-html"], False),
    # `make lint-css` rather than the stylelint command: the glob is a task
    # definition and the Makefile owns those. It lived here, in package.json and
    # in the deploy workflow at once, which is two copies too many for something
    # that has to grow every time a sheet is added.
    ("CSS: duplicate selectors, dead declarations, off-token values",
     ["make", "lint-css"], False),
    # The other two languages. CSS and markup each had a linter and these two
    # had nothing: home.js is 17.9KB and the six .mjs tools and five Python
    # gates below are what every other check in this list is made of, so a
    # broken gate script was previously caught only by the gate failing oddly.
    # `make lint-js` / `make lint-py`, not the tools' own invocations, for the
    # reason the three above give: the Makefile is where a task is defined.
    # lint-py in particular carries a shebang-discovery step that must not get
    # a second copy here -- four of the five files are extensionless and a
    # directory walk silently skips them.
    ("JS: home.js and every .mjs tool", ["make", "lint-js"], False),
    ("Python: every gate script", ["make", "lint-py"], False),
    # Reads styles/tokens.css, no build and no browser, ~0.2s. It has been in
    # the repo since 2956f06 and in no runner, so the audit trail those token
    # comments cite was only ever re-checked when somebody thought to.
    ("Contrast: every token pair clears AA on its darkest surface",
     ["make", "contrast"], False),
    ("Curb: copy and design rules", ["node", "scripts/curb-check.mjs"], False),
    ("Curb: the checker's own detectors still bite", ["node", "scripts/curb-check.mjs", "--self-test"], False),
    ("Render: every band, 1440 and 375, no overflow", ["node", "scripts/shots.mjs", "--out", "scratch/shots/ci"], True),
    # PurgeCSS rather than the hand-rolled scripts/dead-css.mjs: it scans home.js
    # as well as the markup, so a class the script applies at runtime is found
    # instead of needing a hand-maintained exemption list. The hand-rolled one
    # over-reported badly (18.6KB "dead" against PurgeCSS's 2%) and would have
    # deleted live styles if trusted.
    ("CSS: unreachable rules", ["scripts/purge-check"], True),
]


def run(step):
    name, cmd, slow = step
    if QUICK and slow:
        return name, None, ""
    p = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, check=False)
    return name, p.returncode, (p.stdout + p.stderr).strip()


def main() -> int:
    build = subprocess.run(BUILD, cwd=ROOT, capture_output=True, text=True, check=False)
    print(f"{BOLD}{PURPLE}=== Build: eleventy -> _site/ ==={RESET}")
    print((build.stdout + build.stderr).strip())
    if build.returncode:
        print(f"{RED}CI failed: the build did not run{RESET}")
        return 1

    steps = [s for s in STEPS]
    with ThreadPoolExecutor(max_workers=len(steps)) as pool:
        results = list(pool.map(run, steps))

    failed = 0
    for name, code, out in results:
        print(f"\n{BOLD}{PURPLE}=== {name} ==={RESET}")
        if code is None:
            print(f"{DIM}skipped (--quick){RESET}")
            continue
        if out:
            print(out)
        if code == 0:
            print(f"{GREEN}Passed{RESET}")
        else:
            print(f"{RED}Failed{RESET}")
            failed += 1

    print()
    if failed:
        print(f"{RED}CI failed: {failed} step(s){RESET}")
        return 1
    print(f"{GREEN}CI passed{RESET}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
