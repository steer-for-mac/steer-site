#!/usr/bin/env python3
"""Copy the controller names out of Steer's bundled SDL mapping list.

    scripts/sdl-names [path/to/gamecontrollerdb.txt]    (default ../steer's)

Writes src/_data/sdlNames.json: the second CSV field of every
"platform:Mac OS X" row, deduplicated ignoring case, sorted. Copied in and
committed, like `make routes`, because the deploy build has no ../steer.
The compatibility lookup reads it; a name there is in the beta list, which
has never run on a physical pad.
"""
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DB = Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT.parent / "steer/Steer/Sources/Steer/Resources/gamecontrollerdb.txt"
OUT = ROOT / "src/_data/sdlNames.json"

names: dict[str, str] = {}
rows = 0
for line in DB.read_text(encoding="utf-8").splitlines():
    if line.startswith("#") or "platform:Mac OS X" not in line:
        continue
    fields = line.split(",")
    if len(fields) < 3 or not fields[1].strip():
        sys.exit(f"sdl-names: a Mac row with no name: {line[:60]}")
    rows += 1
    name = fields[1].strip()
    names.setdefault(name.casefold(), name)

if rows < 100:
    sys.exit(f"sdl-names: only {rows} Mac rows in {DB}; refusing to write a short list")
out = sorted(names.values(), key=str.casefold)
OUT.write_text(json.dumps({
    "//": f"Generated by `make sdl-names` from steer's gamecontrollerdb.txt ({rows} Mac rows). Do not edit by hand.",
    "names": out,
}, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
print(f"sdl-names: {rows} Mac rows, {len(out)} names -> {OUT.relative_to(ROOT)}")
