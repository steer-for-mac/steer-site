#!/usr/bin/env python3
"""Fail if too much of the shipped CSS is unreachable.

PurgeCSS does the analysis; this only turns its output into a gate. A threshold
rather than zero, because a marketing site legitimately ships a few rules for
states a static scan cannot see, and because auto-stripping CSS on a page whose
whole value is how it looks is not a trade worth making silently.

    scripts/purge-check            fail over 2% removable
    scripts/purge-check --max 5
"""
import json
import os
import subprocess
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
import sys

# Ratcheted 15 -> 2 once the gate became honest. 15 was set while _probe.html
# sat in PurgeCSS's content glob reporting 1.9%, when the real figure was ~21%.
# With that file gone, the band fragments out of the glob (it was the same mistake:
# a build input, not a page), and variables off so the number counts rules
# rather than unused tokens, both sheets read 0.0%.
#
# 2 rather than 0 keeps the docstring's promise below, but the headroom is now
# deliberate rather than inherited: the failure this exists to catch — a band
# dropped from index.src.html while eleventy.config.js still globs its sheet — reads
# 4.2%. Anything above 0 is worth a look.
MAX = float(sys.argv[sys.argv.index("--max") + 1]) if "--max" in sys.argv else 2.0

out = subprocess.run([str(ROOT / "node_modules" / ".bin" / "purgecss"), "--config", "purgecss.config.js"],
                     capture_output=True, text=True)
if out.returncode:
    sys.exit(f"purgecss failed:\n{out.stderr.strip()}")

worst = 0.0
for entry in json.loads(out.stdout):
    name = entry.get("file", "?")
    before = os.path.getsize(name) if os.path.exists(name) else 0
    after = len(entry.get("css", ""))
    pct = 100 * (before - after) / before if before else 0
    worst = max(worst, pct)
    print(f"  {name:12} {before/1024:7.1f} KB -> {after/1024:7.1f} KB   {pct:5.1f}% removable")

print(f"\nworst {worst:.1f}%, threshold {MAX:.0f}%")
sys.exit(1 if worst > MAX else 0)
