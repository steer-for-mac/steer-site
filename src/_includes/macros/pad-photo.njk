{#- The controller as a photo that lights, driven by scripts/pad-photo.js.
    Import `with context`: it reads perapp and padGlyphs. `key` names one
    instance's filters, so the demo and the per-app band share a page. The
    DualSense cut is unlit, so the light bar is drawn on top in the layer's colour. -#}

{% macro vars(key) %}--pp-glow-f:url(#{{ key }}-glow);--pp-lb-f:url(#{{ key }}-lb);--pp-hole-f:url(#{{ key }}-hole){% endmacro %}

{% macro defs(key) %}
<svg class="pp-defs" aria-hidden="true">
  <filter id="{{ key }}-glow" x="-250%" y="-250%" width="600%" height="600%">
    <feMorphology in="SourceAlpha" operator="dilate" radius="2" result="d"/>
    <feGaussianBlur in="d" stdDeviation="6" result="near"/>
    <!-- twice: one wide blur ends in a visible ring on a pale pad -->
    <feGaussianBlur in="d" stdDeviation="26" result="f0"/>
    <feGaussianBlur in="f0" stdDeviation="14" result="far"/>
    <feFlood class="pp-glow-c" result="c"/>
    <feComposite in="c" in2="near" operator="in" result="n"/>
    <feComposite in="c" in2="far" operator="in" result="f"/>
    <!-- outside the part only, so its own fill stays see-through -->
    <feComposite in="n" in2="SourceAlpha" operator="out" result="g1"/>
    <feComposite in="f" in2="SourceAlpha" operator="out" result="g2"/>
    <feMerge><feMergeNode in="g2"/><feMergeNode in="g2"/><feMergeNode in="g2"/><feMergeNode in="g1"/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>
  <filter id="{{ key }}-lb" x="-400%" y="-30%" width="900%" height="160%">
    <feGaussianBlur in="SourceAlpha" stdDeviation="4" result="near"/>
    <feGaussianBlur in="SourceAlpha" stdDeviation="26" result="far"/>
    <feFlood class="pp-lb-c" result="c"/>
    <feComposite in="c" in2="near" operator="in" result="g1"/>
    <feComposite in="c" in2="far" operator="in" result="g2"/>
    <feMerge><feMergeNode in="g2"/><feMergeNode in="g2"/><feMergeNode in="g2"/><feMergeNode in="g1"/><feMergeNode in="g1"/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>
  <filter id="{{ key }}-hole"><feGaussianBlur stdDeviation="3"/></filter>
</svg>
{% endmacro %}

{#- A pill over each shoulder for its trigger, which the photo hides. -#}
{% macro trigs(f) %}{% set c = perapp.controls[f] %}
<div class="pp-trigs" aria-hidden="true">
  <span class="pp-t" data-t="l2" style="--x:{{ c.l1.x }}%"><i></i><b>{{ padGlyphs.name(f, "l2") }}</b></span>
  <span class="pp-t" data-t="r2" style="--x:{{ c.r1.x }}%"><i></i><b>{{ padGlyphs.name(f, "r2") }}</b></span>
</div>
{% endmacro %}

{#- One family's outlines and trigger pills, for a band that brings its own photo. -#}
{% macro outlines(f) %}<div class="pp-o" data-pp-fam="{{ f }}">{{ trigs(f) }}{% include "art/controls-" + f + ".svg" %}</div>{% endmacro %}

{#- The whole controller: photo, outlines, a trigger pill over each shoulder,
    and a picker of the three pads. -#}
{% macro stage(key, first = "ps") %}
<div class="pp pp-stage" data-fam="{{ first }}" style="{{ vars(key) }}">
  {{ defs(key) }}
  {%- for f in padGlyphs.families %}{% set s = perapp.slot[f] %}
  <div class="pp-f" data-pp-fam="{{ f }}" aria-hidden="true">
    {{ trigs(f) }}
    <div class="pp-pad">
      <img src="{{ s.unlit or s.src }}" width="{{ s.w }}" height="{{ s.h }}" loading="lazy" decoding="async" alt="">
      {% include "art/controls-" + f + ".svg" %}
    </div>
  </div>
  {%- endfor %}
  <fieldset class="pp-pick">
    <legend class="llm-only">Controller</legend>
    {%- for f in padGlyphs.families %}{% set s = perapp.slot[f] %}
    <label class="pp-pick-l"><input type="radio" name="{{ key }}-pad" value="{{ f }}"{% if f == first %} checked{% endif %}><img src="{{ s.thumb }}" width="{{ s.tw }}" height="{{ s.th }}" loading="lazy" decoding="async" alt=""><span>{{ s.family }}</span></label>
    {%- endfor %}
  </fieldset>
</div>
{% endmacro %}
