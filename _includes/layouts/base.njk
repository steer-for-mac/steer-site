<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}">
<link rel="canonical" href="{{ canonical }}" />
{%- if home %}
<!-- Markdown surface for LLMs / coding agents. GitHub Pages can't emit an HTTP
     Link header, so this tag is the only alternate advertisement available. -->
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM-friendly Markdown overview" />
{%- endif %}

<!-- Open Graph / Twitter. Card art: assets/og.png -- regenerate from og.html (#v1) when the tagline changes. -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Steer" />
<meta property="og:title" content="{{ ogTitle | default(title) | safe }}" />
<meta property="og:description" content="{{ ogDescription | default(description) | safe }}" />
<meta property="og:url" content="{{ canonical }}" />
<meta property="og:image" content="https://steer.seanfloyd.dev/assets/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="The Steer app icon beside the wordmark Steer and the line: Your whole Mac, from a controller." />
<meta property="og:locale" content="en_CA" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ twitterTitle | default(ogTitle | default(title)) | safe }}" />
<meta name="twitter:description" content="{{ twitterDescription | default(ogDescription | default(description)) | safe }}" />
<meta name="twitter:image" content="https://steer.seanfloyd.dev/assets/og.png" />
<!-- theme init in <head> so the page paints in the right appearance on first frame (no light flash on a dark Mac) -->
{#- The homepage reads one key more than the rest of the site: the accent picker
    in the Feel band writes steer-accent, and the [data-accent] token overrides
    it selects live in styles/tokens.css, which every page loads. Sub-pages
    deliberately do not restore it, so the accent stays a homepage treatment
    rather than a sitewide preference. Before this file existed that split was
    two hand-copied scripts, and they had already drifted. #}
<script>
(function(){var s=null{% if home %},a=null{% endif %};try{s=localStorage.getItem('steer-theme');{% if home %}a=localStorage.getItem('steer-accent');{% endif %}}catch(e){}var d=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.setAttribute('data-theme', s||(d?'dark':'light'));{% if home %}if(a&&a!=='blue'&&a!=='auto')document.documentElement.setAttribute('data-accent',a);{% endif %}})();
</script>
<link rel="icon" type="image/png" href="assets/mark.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="stylesheet" href="site.css">
{%- if home %}
<link rel="stylesheet" href="home.css">
{%- endif %}
{#- A page's own sheet, styles/pages/<page>.css, bundled to _site/<page>.css.
    Same derivable pairing a band has, and the same reason: five pages used to
    carry a <style> block in their front matter and the rest pushed one-page
    rules into shared.css, which ships on all 14. Linked last and unlayered,
    exactly where those <style> blocks sat, so the cascade is unchanged. #}
{%- if pageName in pageSheets %}
<link rel="stylesheet" href="{{ pageName }}.css">
{%- endif %}
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
{%- if head %}
{{ head | safe }}
{%- endif %}
</head>
<body>
<div class="llm-only" aria-hidden="true">An LLM-friendly Markdown overview of Steer is available at https://steer.seanfloyd.dev/llms.txt</div>
{% include "chrome/nav.html" %}
{{ content | safe }}
{% include "chrome/footer.html" %}
{%- if home -%}
{% include "bands/dialogs.html" %}
<script src="home.js" defer></script>
{%- else %}
<script>
(function(){
  var root=document.documentElement,t=document.getElementById('themeToggle');
  if(t)t.addEventListener('click',function(){var n=root.getAttribute('data-theme')==='dark'?'light':'dark';root.setAttribute('data-theme',n);try{localStorage.setItem('steer-theme',n);}catch(e){}});
})();
</script>
{%- endif %}
{%- if bodyEnd %}
{{ bodyEnd | safe }}
{%- endif %}
</body>
</html>
