// Emits. tsconfig.json is the checker.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": false,
    "removeComments": false,
    // rootDir, or tsc infers it from the input and emits dist/src/theme.js.
    "rootDir": "src",
    "outDir": "dist"
  },
  "files": ["src/theme.ts"]
}
