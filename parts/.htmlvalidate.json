{
  "root": true,
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "close-order": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "element-required-content": "off",
    "heading-level": "off",
    "unique-landmark": "off",
    "no-inline-style": [
      "warn",
      {
        "include": [
          "style"
        ]
      }
    ],
    "no-implicit-close": "off"
  }
}
