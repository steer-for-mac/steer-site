{
  "//": "Rules chosen because each has already bitten this repo. Sources only: bin/build generates styles.css and home.css, and Lightning CSS compresses colours there, so linting output flags values nobody wrote.",
  "rules": {
    "no-duplicate-selectors": [
      true,
      {
        "severity": "warning"
      }
    ],
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": [
          "consecutive-duplicates-with-different-values"
        ]
      }
    ],
    "declaration-block-no-shorthand-property-overrides": true,
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "corner-shape"
        ]
      }
    ],
    "unit-no-unknown": true,
    "no-invalid-double-slash-comments": true,
    "no-descending-specificity": null,
    "function-no-unknown": null
  }
}
